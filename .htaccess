
RewriteEngine on
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^stefanos\.cloud$ [OR]
RewriteCond %{HTTP_HOST} ^www\.stefanos\.cloud$
RewriteRule ^/?$ "https\:\/\/stefanos\.cloud\/" [R=301,L]
RewriteCond %{HTTP_HOST} ^stefanos\.cloud$ [OR]
RewriteCond %{HTTP_HOST} ^www\.stefanos\.cloud$
RewriteRule ^el$ "https\:\/\/stefanos\.cloud\/" [R=301,L]

